# Share links (#11). Without these, sharing is off and plots stay in the browser.
# Supabase project settings > API. The service role key is server-only: never
# prefix it with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Any long random string; salts the address hash used for rate limiting.
RATE_LIMIT_SALT=

# Local development without Supabase: keep shared plots in memory.
# PLOT_STORE=memory
