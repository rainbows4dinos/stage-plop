# Share links (#11). Without a store, sharing is off and plots stay in the browser.
# Upstash Redis: add it to the Vercel project from the Marketplace and these are
# set for you. (UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN also work.)
# Server-only: never prefix them with NEXT_PUBLIC_.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Any long random string; salts the address hash used for rate limiting.
RATE_LIMIT_SALT=

# Local development without Upstash: keep shared plots in memory.
# PLOT_STORE=memory
